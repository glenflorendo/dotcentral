#!/bin/bash

# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

set -euo pipefail

readonly CONFIG_FILE="$HOME/.config/mise/config.toml"

if ! command -v mise >/dev/null 2>&1; then
  echo "mise is required to install the configured development tools." >&2
  exit 1
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "mise configuration was not found: $CONFIG_FILE" >&2
  exit 1
fi

echo "Installing mise tools..."
MISE_CONFIG_FILE="$CONFIG_FILE" mise install
